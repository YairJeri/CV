---
<div class="fixed inset-0 -z-50 pointer-events-none overflow-hidden">
    <!-- Subtle technical grid -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff04_1px,transparent_1px),linear-gradient(to_bottom,#ffffff04_1px,transparent_1px)] bg-[size:40px_40px]"></div>

    <!-- Soft radial ambient lighting -->
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-cyan-500/5 rounded-full blur-[140px] -translate-y-1/2"></div>
    <div class="absolute top-1/3 right-10 w-[500px] h-[500px] bg-indigo-500/4 rounded-full blur-[160px]"></div>
    <div class="absolute bottom-1/4 left-1/3 w-[600px] h-[600px] bg-teal-500/4 rounded-full blur-[180px]"></div>

    <!-- Micro-vignette edges -->
    <div class="absolute inset-0 bg-radial-[circle_at_center,transparent_40%,#090a0f_100%] opacity-80"></div>
</div>
