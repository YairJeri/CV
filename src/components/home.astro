---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import TypedText from "../components/typedtext.jsx";

import photo from "../assets/images/photo.jpg";
import type { Translations } from "../i18n/en";

export interface Props {
    t: Translations;
    lang?: string;
    socialLinks: Array<{ href: string; label: string; icon: string }>;
}

const { t, lang = "en", socialLinks } = Astro.props;
---

<section
    id="Home"
    class="min-h-screen relative overflow-hidden flex items-center w-full"
>
    <div class="relative w-full z-10 mt-28">
        <div class="flex flex-row items-center justify-around w-full flex-wrap gap-8">
            <div class="text-center lg:text-left max-w-xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    {t.home.badge}
                </div>

                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] mb-2 text-heading tracking-tight"
                >
                    {t.home.title[0]}
                    <span class="text-cyan-400"> {t.home.title[1]}</span>
                </h1>
                <h2 class="text-2xl md:text-3xl font-mono text-white mt-4 mb-2">
                    Guido Yair Abel Jeri
                </h2>
                <p class="text-xl mb-5 text-default font-mono">
                    <span class="text-zinc-400"> {t.home.prev} </span>
                    <TypedText
                        specialization={t.home.specialization}
                        client:load
                    />
                </p>
                <p
                    class="text-sm md:text-base leading-relaxed text-zinc-300 mb-8 max-w-[520px] mx-auto lg:mx-0"
                >
                    {t.home.about}
                </p>

                {/* Primary Call-to-actions */}
                <div class="flex flex-wrap gap-3.5 w-fit mb-8 mx-auto lg:mx-0 items-center">
                    <a
                        href={`/${lang}/playground`}
                        class="inline-flex items-center gap-2 py-3 px-6 text-sm md:text-base font-mono font-bold rounded-xl transition duration-200 bg-cyan-400 text-black hover:bg-cyan-300 hover:shadow-lg hover:shadow-cyan-500/25 transform hover:-translate-y-0.5"
                    >
                        <Icon name="playground" size={18} />
                        {t.home.playgroundBtn}
                    </a>
                    <a
                        href="#Portfolio"
                        class="py-3 px-5 text-sm md:text-base font-medium rounded-xl border border-white/20 text-zinc-200 hover:border-cyan-400 hover:text-cyan-300 bg-white/5 transition duration-200"
                    >
                        {t.home.viewProjects}
                    </a>
                    <a
                        href={`/files/CV_Yair Jeri_${lang}.pdf`}
                        target="_blank"
                        download
                        class="py-3 px-5 text-sm md:text-base font-medium rounded-xl border border-white/10 text-zinc-300 hover:text-white bg-black/40 hover:bg-white/10 transition duration-200"
                    >
                        {t.home.downloadCv}
                    </a>
                </div>

                <div class="flex gap-4 w-fit mx-auto lg:mx-0 text-center items-center">
                    {
                        socialLinks.map((item) => (
                            <a
                                href={item.href}
                                target="_blank"
                                rel="noreferrer"
                                class="inline-flex items-center justify-center w-10 h-10 text-default rounded-xl bg-white/5 hover:bg-cyan-400 hover:text-black transition duration-200"
                                aria-label={item.label}
                            >
                                <Icon name={item.icon} size={22} />
                            </a>
                        ))
                    }
                </div>
            </div>

            <div
                class="flex items-center justify-center lg:min-w-80 lg:max-w-[440px] lg:w-1/3 aspect-square"
            >
                <div
                    class="relative w-64 h-64 md:w-80 md:h-80 rounded-3xl p-1 bg-gradient-to-tr from-cyan-500/30 via-transparent to-purple-500/20 border border-white/10 shadow-2xl"
                >
                    <Image
                        src={photo}
                        alt="Photo of Yair Jeri"
                        width="720"
                        height="720"
                        class="w-full h-full object-cover rounded-[22px] z-10"
                    />
                </div>
            </div>
        </div>
    </div>
</section>
