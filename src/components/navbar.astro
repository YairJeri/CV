---
import type { Translations } from "../i18n/en";
import { getLanguageNames } from "../i18n";
import LanguageChange from "./language_change.astro";
import { Icon } from "astro-icon/components";

export interface Props {
    lang: string;
    t: Translations;
    socialLinks: Array<{ href: string; label: string; icon: string }>;
}

const { lang, t, socialLinks } = Astro.props;
const navItems = [
    { href: "/" + lang + "/#Home", label: t.navbar.home, icon: "home" },
    { href: "/" + lang + "/#About", label: t.navbar.about, icon: "about" },
    { href: "/" + lang + "/#Skills", label: t.navbar.skills, icon: "skills" },
    { href: "/" + lang + "/#Portfolio", label: t.navbar.portfolio, icon: "portfolio" },
    { href: "/" + lang + "/playground", label: t.navbar.playground, icon: "playground" },
    { href: "/" + lang + "/cv", label: t.navbar.cv, icon: "resume" },
    { href: "/" + lang + "/#Contact", label: t.navbar.contact, icon: "contact" },
];

const languages = getLanguageNames();
---

<span
    id="menu-btn-close"
    class="fixed lg:hidden z-50 top-4 right-4 w-10 h-10 bg-accent rounded-full flex items-center justify-center cursor-pointer opacity-0 scale-90 pointer-events-none transition-all duration-300 shadow-lg"
>
    <Icon name="close" size={16} class="text-contrast" />
</span>

<span
    id="menu-btn"
    class="fixed lg:hidden z-50 top-4 right-4 w-10 h-10 bg-accent rounded-full flex items-center justify-center cursor-pointer opacity-100 scale-100 transition-all duration-300 shadow-lg"
>
    <Icon id="menu-btn" name="menu" size={16} class="text-contrast" />
</span>

<header
    id="menu"
    class="flex overflow-visible flex-col justify-center fixed top-1/2 lg:left-0 -left-full -translate-y-1/2 w-[300px] z-50 py-0 px-4 text-default transition-all duration-300 ease-in-out"
>
    <div
        class="flex flex-col items-center p-4 rounded-3xl bg-surface/95 backdrop-blur-md border border-white/10 shadow-2xl"
    >
        <div class="mb-2 text-center">
            <span class="text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase">Yair Jeri</span>
            <p class="text-[11px] font-mono text-zinc-400">{t.navbar.roleSubtitle}</p>
        </div>

        <nav class="w-full p-0">
            {
                navItems.map((item) => (
                    <ul class="flex items-center w-full py-2.5 px-2.5 text-base font-normal font-nav text-nav whitespace-nowrap duration-300">
                        <a
                            href={item.href}
                            class="group flex items-center w-full text-base text-zinc-300 hover:text-cyan-400 active:text-cyan-300 duration-200"
                        >
                            <Icon
                                name={item.icon}
                                size={20}
                                class="mr-3 w-5 h-5 inline-block text-zinc-400 group-hover:text-cyan-400 transition-colors"
                            />
                            {item.label}
                            {item.icon === "playground" && (
                                <span class="ml-auto text-[9px] font-mono font-bold bg-cyan-950 text-cyan-300 border border-cyan-800 px-1.5 py-0.5 rounded">
                                    LIVE
                                </span>
                            )}
                        </a>
                    </ul>
                ))
            }
        </nav>

        <div class="text-center mt-3 pt-3 border-t border-white/5 w-full flex justify-center gap-1">
            {
                socialLinks.map((item) => (
                    <a
                        href={item.href}
                        target="_blank"
                        rel="noreferrer"
                        class="group inline-flex items-center justify-center w-10 h-10 text-default rounded-full bg-white/5 duration-200 hover:text-contrast hover:bg-cyan-400"
                        aria-label={item.label}
                    >
                        <Icon name={item.icon} size={22} />
                    </a>
                ))
            }
        </div>
        <div class="mt-4 relative w-full overflow-visible">
            <LanguageChange lang={lang} languages={languages} />
        </div>
    </div>
    <script type="module">
        const btnClose = document.getElementById("menu-btn-close");
        const btn = document.getElementById("menu-btn");
        const menu = document.getElementById("menu");

        const toggleButton = (showBtn, hideBtn) => {
            showBtn.classList.remove("opacity-0", "scale-90", "pointer-events-none");
            showBtn.classList.add("opacity-100", "scale-100");

            hideBtn.classList.remove("opacity-100", "scale-100");
            hideBtn.classList.add("opacity-0", "scale-90", "pointer-events-none");
        };

        if (btn && btnClose && menu) {
            btn.addEventListener("click", () => {
                menu.classList.toggle("-left-full");
                menu.classList.toggle("left-0");
                toggleButton(btnClose, btn);
            });

            btnClose.addEventListener("click", () => {
                menu.classList.toggle("-left-full");
                menu.classList.toggle("left-0");
                toggleButton(btn, btnClose);
            });
        }
    </script>
</header>
