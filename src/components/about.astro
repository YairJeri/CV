---
import type { Translations } from "../i18n/en";

export interface Props {
    t: Translations;
}

const { t } = Astro.props;
---

<section id="About" class="relative">
    <div class="p-8 sm:p-10 rounded-2xl bg-surface/90 border border-white/10 shadow-xl backdrop-blur">
        <div class="mb-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono">
                {t.about.badge}
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug">
                {t.about.header}
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-white/10">
            {t.about.columns.map((col, idx) => {
                const color = idx === 0 ? "text-cyan-400" : idx === 1 ? "text-emerald-400" : "text-purple-400";
                return (
                    <div class="flex flex-col gap-2">
                        <span class={`text-xs font-mono ${color} font-semibold uppercase tracking-wider`}>
                            {col.title}
                        </span>
                        <p class="text-sm text-zinc-300 leading-relaxed">
                            {col.desc}
                        </p>
                    </div>
                );
            })}
        </div>
    </div>
</section>
