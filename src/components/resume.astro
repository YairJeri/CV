---
import type { Translations } from "../i18n/en";
import type { Resume } from "../types/resume";

export interface Props {
    t: Translations;
    lang: string;
    resume: Resume;
    isComplete?: boolean;
}

const { t, resume, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="Resume" class="relative">
    <div class="mb-10 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono">
            {t.resume.badge}
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-2">
            {t.resume.title}
        </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-8 bg-surface/90 border border-white/10 rounded-2xl shadow-xl backdrop-blur">
        {/* Education Block */}
        <div class="flex flex-col gap-3">
            <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider font-semibold">
                {resume.education.title}
            </span>
            <div class="p-4 rounded-xl bg-black/40 border border-white/5">
                <h4 class="text-base font-bold text-white mb-1">
                    {t.resume.degree}
                </h4>
                <p class="text-xs font-mono text-cyan-400 mb-2">
                    {t.resume.university}
                </p>
                <p class="text-xs text-zinc-400 leading-relaxed">
                    {t.resume.focus}
                </p>
            </div>
        </div>

        {/* Languages Block */}
        <div class="flex flex-col gap-3">
            <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider font-semibold">
                {t.resume.languagesTitle}
            </span>
            <div class="flex flex-col gap-2.5">
                {resume.languages.content.map((langItem) => (
                    <div class="p-3.5 rounded-xl bg-black/40 border border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4">
                        <span class="text-sm font-bold text-white font-mono shrink-0">
                            {langItem.language}
                        </span>
                        <span class="text-xs text-zinc-400 font-mono sm:text-right">
                            {langItem.level}
                        </span>
                    </div>
                ))}
            </div>

            {/* Quick CV Download button */}
            <div class="pt-2 mt-auto">
                <a
                    href={`${base}/files/CV_Yair Jeri_${lang}.pdf`}
                    download={`CV_Yair Jeri_${lang}.pdf`}
                    class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-xl text-xs font-mono font-bold bg-white/5 hover:bg-cyan-500 text-zinc-300 hover:text-black border border-white/10 hover:border-cyan-400 transition-all duration-200"
                >
                    {t.resume.downloadButton}
                </a>
            </div>
        </div>
    </div>
</section>
