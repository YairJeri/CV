---
import "../styles/global.css";
import Navbar from "../components/navbar.astro";
import AmbientBackground from "../components/background_ambient.astro";
import Shade from "../components/shade.astro";
import type { Translations } from "../i18n/en";
import Contact from "../components/contact.astro";

export interface Props {
	title?: string;
	lang: string;
	t: Translations;
	socialLinks: Array<{ href: string; label: string; icon: string }>;
	email: string;
}

const { lang, t, title, socialLinks, email } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.3.2/css/flag-icons.min.css"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-bg text-default font-default h-full w-full min-h-screen">
		<AmbientBackground />
		<Navbar lang={lang} t={t} socialLinks={socialLinks} />
		<div class="lg:ml-72">
			<div
				class="px-6 md:px-10 max-w-[1300px] flex flex-col mx-auto gap-20"
			>
				<slot />
				<Contact
					t={t}
					email={email}
					github={socialLinks[0].href}
					linkedin={socialLinks[1].href}
				/>
			</div>
		</div>
	</body>
</html>
