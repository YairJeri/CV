---
import Layout from "../../layouts/layout.astro";
import PlaygroundTabs from "../../components/playground/PlaygroundTabs";
import { getTranslations, availableLangs } from "../../i18n";

export async function getStaticPaths() {
    return availableLangs.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const t = await getTranslations(lang);

const socialLinks = [
    {
        href: "https://github.com/YairJeri",
        label: "Github",
        icon: "github",
    },
    {
        href: "https://www.linkedin.com/in/yair-jeri-37113436b",
        label: "Linkedin",
        icon: "linkedin",
    },
];

const email = "Guidoyair@hotmail.com";
---

<Layout
    title={lang === "es"
        ? "Laboratorio Computacional | Yair Jeri"
        : "Computational Playground | Yair Jeri"}
    lang={lang}
    t={t}
    socialLinks={socialLinks}
    email={email}
>
    <section class="w-full pt-10 flex flex-col gap-6">
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <span
                    class="px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30"
                >
                    INTERACTIVE COMPUTATIONAL SUITE
                </span>
            </div>
            <h1
                class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight"
            >
                {
                    lang === "es"
                        ? "Laboratorio de Algoritmos y Física"
                        : "Computational Algorithms & Physics Laboratory"
                }
            </h1>
            <p
                class="text-zinc-400 max-w-3xl text-sm sm:text-base leading-relaxed"
            >
                {
                    lang === "es"
                        ? "Simulaciones interactivas de ordenamiento, grafos, física de partículas y autómatas celulares ejecutándose directamente en el navegador."
                        : "Interactive sorting benchmarks, graph algorithms, particle physics, and cellular automata running directly in the browser."
                }
            </p>
        </div>

        {/* Interactive Tabbed Laboratories */}
        <PlaygroundTabs client:load lang={lang} />
    </section>
</Layout>
