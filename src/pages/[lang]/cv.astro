---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/layout.astro";
import { availableLangs, getTranslations } from "../../i18n";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    return availableLangs.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const t = await getTranslations(lang);

const allResumes = await getCollection("resume");
const resumeEntry = allResumes.find((r) => r.id === `${lang}/resume` || r.id === `${lang}/resume.md`) || allResumes[0];

if (!resumeEntry) {
    throw new Error(`Resume content not found for lang: ${lang}`);
}

const { data } = resumeEntry;

const socialLinks = [
    {
        href: "https://github.com/YairJeri",
        label: "Github",
        icon: "github",
    },
    {
        href: "https://www.linkedin.com/in/yair-jeri-37113436b",
        label: "Linkedin",
        icon: "linkedin",
    },
];
const email = "Guidoyair@hotmail.com";

const cvTitle = lang === "es" ? "Curriculum Vitae | Yair Jeri" : "Curriculum Vitae | Yair Jeri";
const downloadPdfLabel = lang === "es" ? "Descargar PDF" : "Download PDF";
const backLabel = lang === "es" ? "← Volver al Inicio" : "← Back to Home";
const printLabel = lang === "es" ? "Imprimir" : "Print";
const certsTitle = lang === "es" ? "Certificados y Constancias" : "Certificates & Credentials";

// Load all certificates from src/content/cert
const certImages = import.meta.glob<{ default: ImageMetadata }>("../../content/cert/*.{jpg,jpeg,png}", { eager: true });
const certList = Object.entries(certImages).sort(([pathA], [pathB]) => {
    const numA = parseInt(pathA.replace(/\D/g, ""), 10) || 0;
    const numB = parseInt(pathB.replace(/\D/g, ""), 10) || 0;
    return numA - numB;
}).map(([_, mod]) => mod.default);
---

<Layout title={cvTitle} lang={lang} t={t} socialLinks={socialLinks} email={email}>
    <main class="w-full max-w-4xl mx-auto pt-6 sm:pt-10 pb-20 flex flex-col gap-6">
        {/* Navigation & Action Bar */}
        <div class="flex items-center justify-between flex-wrap gap-4 p-4 bg-surface/80 backdrop-blur rounded-2xl border border-white/10 print:hidden">
            <a
                href={`/${lang}`}
                class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-zinc-400 hover:text-cyan-400 transition"
            >
                {backLabel}
            </a>

            <div class="flex items-center gap-3">
                <button
                    onclick="window.print()"
                    class="inline-flex items-center gap-1.5 py-2 px-3.5 rounded-xl text-xs font-mono font-bold bg-white/5 hover:bg-white/10 text-zinc-300 border border-white/10 transition"
                >
                    <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                    </svg>
                    <span>{printLabel}</span>
                </button>

                <a
                    href={`/files/CV_Yair Jeri_${lang}.pdf`}
                    download={`CV_Yair Jeri_${lang}.pdf`}
                    class="inline-flex items-center gap-2 py-2 px-4 rounded-xl text-xs font-mono font-bold bg-cyan-500 hover:bg-cyan-400 text-black shadow-lg shadow-cyan-500/20 transition-all"
                >
                    <svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    <span>{downloadPdfLabel}</span>
                </a>
            </div>
        </div>

        {/* Executive Resume Paper Layout */}
        <article class="p-8 sm:p-12 bg-surface/90 border border-white/10 rounded-2xl shadow-2xl backdrop-blur flex flex-col gap-8 print:p-0 print:border-none print:bg-white print:text-black print:shadow-none">
            {/* Header */}
            <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border-b border-white/10 pb-6 print:border-slate-300">
                <div class="flex flex-col gap-2">
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight print:text-slate-900">
                        {data.name}
                    </h1>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-zinc-400 print:text-slate-600">
                        {data.quickInformation.map((info, idx) => (
                            <span>
                                {info}
                                {idx < data.quickInformation.length - 1 && <span class="text-zinc-600 print:text-slate-400 ml-3">|</span>}
                            </span>
                        ))}
                    </div>
                </div>

                {data.image && (
                    <Image
                        src={data.image}
                        alt={data.name}
                        width={84}
                        height={84}
                        class="w-20 h-20 rounded-xl object-cover border border-white/10 shadow-md shrink-0 print:border-slate-300"
                    />
                )}
            </header>

            {/* Profile */}
            <section class="flex flex-col gap-3">
                <h2 class="text-xs font-mono uppercase tracking-wider font-bold text-cyan-400 print:text-cyan-700">
                    {data.professionalProfile.title}
                </h2>
                <div class="text-sm text-zinc-300 leading-relaxed space-y-2 print:text-slate-800">
                    {data.professionalProfile.content.map((p) => (
                        <p>{p}</p>
                    ))}
                </div>
            </section>

            {/* Technical Skills */}
            <section class="flex flex-col gap-3">
                <h2 class="text-xs font-mono uppercase tracking-wider font-bold text-cyan-400 print:text-cyan-700">
                    {data.skills.title}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {data.skills.content.map((group) =>
                        Object.entries(group).map(([category, items]) => (
                            <div class="p-3.5 rounded-xl bg-black/40 border border-white/5 print:bg-slate-50 print:border-slate-200">
                                <span class="text-xs font-bold text-white font-mono block mb-1.5 print:text-slate-900">
                                    {category}
                                </span>
                                <ul class="text-xs text-zinc-400 space-y-1 print:text-slate-700">
                                    {(items as string[]).map((item) => (
                                        <li class="flex items-start gap-1.5">
                                            <span class="text-cyan-400 shrink-0 print:text-cyan-700">•</span>
                                            <span>{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    )}
                </div>
            </section>

            {/* Education */}
            <section class="flex flex-col gap-3">
                <h2 class="text-xs font-mono uppercase tracking-wider font-bold text-cyan-400 print:text-cyan-700">
                    {data.education.title}
                </h2>
                <div class="p-4 rounded-xl bg-black/40 border border-white/5 text-xs text-zinc-300 space-y-1 print:bg-slate-50 print:border-slate-200 print:text-slate-800">
                    {data.education.content.map((item) => (
                        <p class="font-mono">{item}</p>
                    ))}
                </div>
            </section>

            {/* Projects */}
            <section class="flex flex-col gap-3">
                <h2 class="text-xs font-mono uppercase tracking-wider font-bold text-cyan-400 print:text-cyan-700">
                    {data.projects.title}
                </h2>
                <div class="grid grid-cols-1 gap-2.5">
                    {data.projects.content.map((proj) => {
                        const parts = proj.split(":");
                        const title = parts[0];
                        const details = parts.slice(1).join(":");
                        return (
                            <div class="p-3 rounded-xl bg-black/40 border border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 print:bg-slate-50 print:border-slate-200">
                                <span class="text-xs font-bold text-white font-mono shrink-0 print:text-slate-900">
                                    {title}
                                </span>
                                <span class="text-xs text-zinc-400 font-mono sm:text-right print:text-slate-600">
                                    {details}
                                </span>
                            </div>
                        );
                    })}
                </div>
            </section>

            {/* Languages & Additional Info */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <section class="flex flex-col gap-3">
                    <h2 class="text-xs font-mono uppercase tracking-wider font-bold text-cyan-400 print:text-cyan-700">
                        {data.languages.title}
                    </h2>
                    <div class="space-y-2">
                        {data.languages.content.map((langItem) => (
                            <div class="p-3 rounded-xl bg-black/40 border border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 print:bg-slate-50 print:border-slate-200">
                                <span class="text-xs font-bold text-white font-mono print:text-slate-900">
                                    {langItem.language}
                                </span>
                                <span class="text-xs text-zinc-400 font-mono sm:text-right print:text-slate-600">
                                    {langItem.level}
                                </span>
                            </div>
                        ))}
                    </div>
                </section>

                <section class="flex flex-col gap-3">
                    <h2 class="text-xs font-mono uppercase tracking-wider font-bold text-cyan-400 print:text-cyan-700">
                        {data.additionalInfo.title}
                    </h2>
                    <div class="p-3.5 rounded-xl bg-black/40 border border-white/5 text-xs text-zinc-400 space-y-1.5 print:bg-slate-50 print:border-slate-200 print:text-slate-700">
                        {data.additionalInfo.content.map((info) => (
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shrink-0 print:bg-cyan-700"></span>
                                <span>{info}</span>
                            </div>
                        ))}
                    </div>
                </section>
            </div>

            {/* Certificates Gallery */}
            {certList.length > 0 && (
                <section class="flex flex-col gap-4 pt-6 border-t border-white/10 print:border-slate-300">
                    <h2 class="text-xs font-mono uppercase tracking-wider font-bold text-cyan-400 print:text-cyan-700">
                        {certsTitle}
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {certList.map((certImg, idx) => (
                            <a
                                href={certImg.src}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group relative rounded-xl overflow-hidden border border-white/10 hover:border-cyan-500/50 bg-black/40 transition-all duration-300 shadow-lg hover:shadow-cyan-500/10 block"
                            >
                                <Image
                                    src={certImg}
                                    alt={`Certificate ${idx + 1}`}
                                    width={400}
                                    height={280}
                                    class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                                    <span class="text-[11px] font-mono text-cyan-300 font-semibold flex items-center gap-1.5">
                                        <span>Ver Certificado ↗</span>
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )}
        </article>
    </main>
</Layout>

